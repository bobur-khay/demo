# mock keeps the dashboard usable without accessible device hrefs.
DATA_SOURCE=mock
POLL_INTERVAL_SECONDS=2
HISTORY_DAYS=30
MAX_POINTS_PER_SERIES=50000
TDS_DIRECTORY=../tds
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Optional InfluxDB 3 Cloud history and persistence. Configure all three.
# INFLUX_HOST=https://your-cluster.influxdata.com
# INFLUX_TOKEN=replace-with-a-secret-from-your-runtime
# INFLUX_DATABASE=your-database
# INFLUX_ORG=your-organization
# INFLUX_MEASUREMENT=device_telemetry
