# mock | wot
DATA_SOURCE=wot 
# mock | influxdb
HISTORY_DATA_SOURCE=influxdb

POLL_INTERVAL_SECONDS=2
HISTORY_DAYS=30
MAX_POINTS_PER_SERIES=50000
TDS_DIRECTORY=../tds
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO


# InfluxDB 1.8 (ChirpStack database, read-only source for trends)
INFLUX_HOST=http://192.168.100.30:8086
INFLUX_DATABASE=chirpstack
# Optional, only when the instance has authentication enabled
INFLUX_USERNAME=
INFLUX_PASSWORD=
INFLUX_MEASUREMENT_PREFIX=device_frmpayload_data_
